rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Usernames are stored as the part of the login email before the @
    function me() { return request.auth.token.email.split('@')[0]; }
    function inChat(chatId) { return chatId.split('_').hasAny([me()]); }

    // One public account directory entry per username (readable by any signed-in user, online or offline)
    match /users/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && name == me()
                    && name.matches('^[a-z0-9]{3,16}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == name
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 240))
                    && (!('mood' in request.resource.data) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 60));
      allow update: if signedIn()
                    && name == me()
                    && request.resource.data.username == name
                    && request.resource.data.uid == request.auth.uid
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && request.resource.data.keys().hasOnly(['username', 'uid', 'createdAt', 'bio', 'mood'])
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 240))
                    && (!('mood' in request.resource.data) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 60));
      allow delete: if false;

      // Each user's own friends list: users/{me}/friends/{friendUsername}
      match /friends/{friend} {
        allow read: if signedIn() && name == me();
        allow create: if signedIn()
                      && name == me()
                      && friend != name
                      && friend.matches('^[a-z0-9]{3,16}$')
                      && exists(/databases/$(database)/documents/users/$(friend))
                      && request.resource.data.keys().hasOnly(['username', 'addedAt'])
                      && request.resource.data.username == friend;
        allow delete: if signedIn() && name == me();
        allow update: if false;
      }
    }

    // Tamper-resistant visitor counter:
    // Each browser creates a unique 32-char hex receipt in /visitors/{browserId} (create-only, no update/delete).
    // /meta/visitors can ONLY be created at 1 or incremented by +1 in the exact same batch as a new /visitors/{browserId} receipt.
    match /visitors/{browserId} {
      allow get: if browserId.matches('^[a-f0-9]{32}$');
      allow list: if false;
      allow create: if browserId.matches('^[a-f0-9]{32}$')
                    && request.resource.data.keys().hasOnly(['createdAt'])
                    && request.resource.data.createdAt == request.time
                    && (
                      (
                        !exists(/databases/$(database)/documents/meta/visitors)
                        && getAfter(/databases/$(database)/documents/meta/visitors).data.count == 1
                      )
                      || (
                        exists(/databases/$(database)/documents/meta/visitors)
                        && getAfter(/databases/$(database)/documents/meta/visitors).data.count
                           == get(/databases/$(database)/documents/meta/visitors).data.count + 1
                      )
                    );
      allow update, delete: if false;
    }

    match /meta/visitors {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Who is online: each user keeps a "last seen" timestamp fresh while the site is open
    match /presence/{name} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && name == me()
                            && request.resource.data.keys().hasOnly(['username', 'lastSeen'])
                            && request.resource.data.username == name
                            && request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && name == me();
    }

    // chatId = the two usernames sorted and joined by "_"
    match /chats/{chatId} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create, update: if signedIn()
                            && inChat(chatId)
                            && request.resource.data.participants.size() == 2
                            && request.resource.data.participants.hasAll(chatId.split('_'));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && inChat(chatId);
        allow create: if signedIn()
                      && inChat(chatId)
                      && request.resource.data.from == me()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}
