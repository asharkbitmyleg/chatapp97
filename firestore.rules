rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Usernames are stored as the part of the login email before the @
    function me() { return request.auth.token.email.split('@')[0]; }
    function inChat(chatId) { return chatId.split('_').hasAny([me()]); }

    // One public profile per username (used for search)
    match /users/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && name == me()
                    && name.matches('^[a-z0-9]{3,16}$')
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;

      // Each user's own friends list: users/{me}/friends/{friendUsername}
      match /friends/{friend} {
        allow read: if signedIn() && name == me();
        allow create: if signedIn()
                      && name == me()
                      && friend != name
                      && friend.matches('^[a-z0-9]{3,16}$')
                      && exists(/databases/$(database)/documents/users/$(friend))
                      && request.resource.data.keys().hasOnly(['username', 'addedAt'])
                      && request.resource.data.username == friend;
        allow delete: if signedIn() && name == me();
        allow update: if false;
      }
    }

    // Public visitor counter. Anyone can read it; the only write allowed is +1.
    match /meta/visitors {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // chatId = the two usernames sorted and joined by "_"
    match /chats/{chatId} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create, update: if signedIn()
                            && inChat(chatId)
                            && request.resource.data.participants.size() == 2
                            && request.resource.data.participants.hasAll(chatId.split('_'));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && inChat(chatId);
        allow create: if signedIn()
                      && inChat(chatId)
                      && request.resource.data.from == me()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}
